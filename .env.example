# Copy this file to .env and fill in your own values.
# .env is loaded automatically by config.py — never commit the real .env.

# Ollama (free, local LLM — https://ollama.com)
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3.2

# Pexels (free stock video/photo API — https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_here

# Pixabay (free, optional second stock source for more topic coverage
# — https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_key_here

# Audience the scripts are written for
AUDIENCE=curious people who love quick, fun facts

# YouTube upload settings
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false
